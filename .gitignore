# Large Adobe Illustrator source files — rendered derivatives live in assets/
Data-Visual-waves/

# macOS metadata
.DS_Store

# Client engagement workspaces — only _template/ belongs in the repo.
# Real client folders live locally (or on a personal branch) and never reach main.
memory/clients/*/
!memory/clients/_template/
!memory/clients/_template/**

# Python bytecode
__pycache__/
*.pyc

# Session working artifacts (audit runs, SDD task records) — local only
.superpowers/

# Per-session client-isolation markers, written by tools/client-isolation-hook.sh.
# One file per session id; stale files are inert and pruned at session start.
.claude/session-clients/

# Legacy single-pointer marker (removed from the architecture; never commit if present)
.claude/active-client
